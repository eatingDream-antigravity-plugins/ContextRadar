{
  "context-radar-boot": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./bin/context-radar-mcp guard boot",
        "timeout": 3
      }
    ]
  },
  "context-radar-exec": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/context-radar-mcp guard exec",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
